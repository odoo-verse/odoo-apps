<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="inherit_product_template_kanban" model="ir.ui.view">
             <field name="name">inherit.product.template.kanban</field>
             <field name="model">product.template</field>
             <field name="inherit_id" ref="product.product_template_kanban_view"/>
             <field name="arch" type="xml">

                 <xpath expr="//div[@name='product_lst_price']" position="before">
                    <field name="is_sale_price_hide" invisible="1"/>
                 </xpath>

                 <xpath expr="//div[@name='product_lst_price']" position="attributes">
                     <attribute name="invisible">is_sale_price_hide</attribute>
                 </xpath>

             </field>
        </record>
        <record id="inherit_product_template_form" model="ir.ui.view">
            <field name="name">inherit.product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group_standard_price']" position="inside">
                    <field name="is_cost_hide" invisible="1" />
                    <field name="is_sale_price_hide" invisible="1" />
                </xpath>

                <xpath expr="//label[@for='standard_price']" position="attributes">
                        <attribute name="invisible">is_cost_hide or id and product_variant_count != 1 and not is_product_variant</attribute>
                </xpath>
                <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                        <attribute name="invisible">is_cost_hide or id and product_variant_count != 1 and not is_product_variant</attribute>
                </xpath>

                <xpath expr="//label[@for='list_price']" position="attributes">
                        <attribute name="invisible">is_sale_price_hide</attribute>
                </xpath>
                <xpath expr="//div[@name='pricing']" position="attributes">
                        <attribute name="invisible">is_sale_price_hide</attribute>
                </xpath>

            </field>
    </record>

        <record id="inherit_product_template_tree" model="ir.ui.view">
        <field name="name">inherit.product.template.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="before">
              <field name="is_cost_hide" column_invisible="1"/>
              <field name="is_sale_price_hide" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="invisible">is_cost_hide</attribute>
            </xpath>

            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="invisible">is_sale_price_hide</attribute>
            </xpath>

        </field>
    </record>

    <record id="inherit_product_product_tree" model="ir.ui.view">
        <field name="name">inherit.product.product.tree</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="before">
              <field name="is_cost_hide" column_invisible="1"/>
              <field name="is_sale_price_hide" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="invisible">is_cost_hide</attribute>
            </xpath>

            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="invisible">is_sale_price_hide</attribute>
            </xpath>

        </field>
    </record>

    <record id="inherit_product_product_form" model="ir.ui.view">
        <field name="name">inherit.product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="before">
              <field name="is_sale_price_hide" invisible="1"/>
            </xpath>

            <xpath expr="//label[@for='lst_price']" position="attributes">
                <attribute name="invisible">is_sale_price_hide</attribute>
            </xpath>

            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="invisible">is_sale_price_hide</attribute>
            </xpath>

        </field>
    </record>


    </data>

</odoo>
